#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  login)
    for argument in "$@"; do
      if [ "$argument" = "--password-stdin" ]; then
        IFS= read -r password
        test -n "$password"
        break
      fi
    done
    ;;
  logout)
    ;;
  *)
    echo "Unsupported docker shim command" >&2
    exit 2
    ;;
esac
